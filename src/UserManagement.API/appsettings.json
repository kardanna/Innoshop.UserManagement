{
  "Authentication" :
  {
    "Jwt":
    {
      "Issuer" : "http://users_api:8080",
      "Audience" : "http://innoshop.by",
      "AccessTokenLifetimeMinutes" : 15,
      "RefreshTokenLifetimeMinutes" : 43200
    },

    "SigningKeyOptions":
    {
      "SingingKeyLifetimeDays" : 90,
      "ValidationKeyLifetimeDays" : 180,
      "KeySizeBytes" : 4096
    }
  },
  
  "UserManagement" :
  {
    "LoginOptions" :
    {
      "LoginAttemptsMaxCount" : 3,
      "LoginAttemptsTimeWindowInMinutes" : 5
    },

    "RegistrationOptions" :
    {
      "MustBeAtLeastYears" : 14
    },

    "EmailOptions" : 
    {
      "VerificationCodeLifetimeInHours" : 24,
      "UserCanChangeEmailOnceInHowManyHours" : 0,
      "EmailSender" : "no-reply@innoshop.by",
      "Sender" : "innoshop.by"
    },

    "PasswordOptions" :
    {
      "PasswordRestoreAttemptLifetimeInHours" : 24
    }
  },
  
  "Serilog" : {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft" : "Information"
      }
    },
    "WriteTo" : [
      { "Name" : "Console" },
      {
        "Name" : "Seq",
        "Args" : { "serverUrl" : "http://users_seq:5341" }
      }
    ],
    "Enrich" : [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "RabbitMQ" :
  {
    "HostName" : "innoshop_rabbitmq",
    "Port" : 5672,
    "UserName" : "admin",
    "Password" : "admin"
  },

  "Papercut" :
  {
    "HostName" : "innoshop_papercut",
    "Port" : 2525
  },

  "ConnectionStrings":
  {
    "SqlServer" : "Server=users_db,1433;Database=UserManagement;User=sa;Password=QWERTY!!11qwerty;TrustServerCertificate=True;",
    "PostgreSQL" : "Server=users_db_postgresql;Port=5432;Database=users_db;Username=admin;Password=admin"
  },

  "AllowedHosts": "*"
}
